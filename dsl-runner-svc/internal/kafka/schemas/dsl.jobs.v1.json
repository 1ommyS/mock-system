{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dsl.jobs.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "jobKey",
    "createdAt",
    "mode",
    "seed",
    "baseMock",
    "params",
    "limits"
  ],
  "properties": {
    "jobId": { "type": "string", "format": "uuid" },
    "jobKey": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "mode": { "type": "string", "enum": ["preview", "apply"] },
    "seed": { "type": "string" },
    "baseMockId": { "type": ["string", "null"], "format": "uuid" },
    "dslScriptId": { "type": ["string", "null"], "format": "uuid" },
    "dslScript": { "type": ["string", "null"] },
    "baseMock": { "type": "object" },
    "params": { "type": "object" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "maxGeneratedMocks", "maxResultBytes"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "maxGeneratedMocks": { "type": "integer", "minimum": 1 },
        "maxResultBytes": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "anyOf": [
    { "required": ["dslScript"] },
    { "required": ["dslScriptId"] }
  ]
}
